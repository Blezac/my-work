-- Email templates
INSERT INTO `email_templates` (`slug`, `subject`, `body_html`, `variables`) VALUES
('ticket_created', 'Ticket #{ticket_id} Created - {subject}',
'<h2>Your ticket has been received</h2><p>Dear {customer_name},</p><p>We have received your support request. Your ticket ID is <strong>{ticket_id}</strong>.</p><p><strong>Subject:</strong> {subject}<br><strong>Priority:</strong> {priority}<br><strong>Department:</strong> {department}</p><p>Our team will respond shortly.</p><p>Best regards,<br>Greendome Engineering Support</p>',
'ticket_id,subject,customer_name,priority,department'),
('ticket_reply', 'New Reply on Ticket #{ticket_id}',
'<h2>New reply on your ticket</h2><p>Dear {customer_name},</p><p>A staff member has replied to your ticket <strong>{ticket_id}</strong>.</p><p>{reply_preview}</p><p><a href="{ticket_url}">View Full Conversation</a></p>',
'ticket_id,customer_name,reply_preview,ticket_url'),
('ticket_resolved', 'Ticket #{ticket_id} Resolved',
'<h2>Your ticket has been resolved</h2><p>Dear {customer_name},</p><p>Ticket <strong>{ticket_id}</strong> has been marked as resolved.</p><p>If you need further assistance, you can reopen the ticket by replying.</p>',
'ticket_id,customer_name');
