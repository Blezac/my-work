Options -Indexes
Options -MultiViews

RewriteEngine On

# Block sensitive files
RewriteRule ^\.env$ - [F,L]
RewriteRule ^\.git - [F,L]

# Allow direct access to real files and directories (CSS, JS, images)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else to index.php
RewriteRule ^(.*)$ index.php [QSA,L]
