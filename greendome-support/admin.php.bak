<div class="stat"><div class="stat-num"><?=$stats['fol_c']?></div><div class="stat-lbl">Follow-up</div></div>
<div class="stat"><div class="stat-num"><?=$stats['res_c']?></div><div class="stat-lbl">Responded</div></div>
<div class="stat"><div class="stat-num"><?=$stats['clo_c']?></div><div class="stat-lbl">Closed</div></div>
</div>
<?php endif; ?>

<div class="card">
