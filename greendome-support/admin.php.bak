<?php

require_once 'includes/config.php';
session_start();

if (!isset($_SESSION['staff_logged_in']) || $_SESSION['staff_logged_in'] !== true) {
    header("Location: login.php");
    exit;
}

$pdo = getDBConnection();
$staff_name = $_SESSION['staff_name'];
$staff_role = $_SESSION['staff_role'] ?? 'Staff';

// Activity logging function
function logActivity($pdo, $staff_name, $action_type, $ticket_id = null, $details = null) {
    try {
        $ip = $_SERVER['REMOTE_ADDR'] ?? '0.0.0.0';
        $stmt = $pdo->prepare("INSERT INTO activity_logs (staff_name, action_type, ticket_id, details, ip_address) VALUES (?, ?, ?, ?, ?)");
        $stmt->execute([$staff_name, $action_type, $ticket_id, $details, $ip]);
    } catch (Exception $e) {
        error_log("Activity log error: " . $e->getMessage());
    }
}

// Handle actions
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    $ticket_id = intval($_POST['ticket_id'] ?? 0);

    if ($action === 'soft_delete' && in_array($staff_role, ['Admin', 'Super Admin'])) {
        $pdo->prepare("UPDATE tickets SET is_deleted=1, deleted_by=?, deleted_at=NOW() WHERE id=?")->execute([$staff_name, $ticket_id]);
        logActivity($pdo, $staff_name, 'Soft Delete Ticket', $ticket_id);
        $_SESSION['msg'] = ['Ticket moved to trash!', 'success'];
        header("Location: admin.php?page=tickets&view=active");
        exit;
    }

    if ($action === 'restore' && in_array($staff_role, ['Admin', 'Super Admin'])) {
        $pdo->prepare("UPDATE tickets SET is_deleted=0, deleted_by=NULL, deleted_at=NULL WHERE id=?")->execute([$ticket_id]);
        logActivity($pdo, $staff_name, 'Restore Ticket', $ticket_id);
        $_SESSION['msg'] = ['Ticket restored!', 'success'];
        header("Location: admin.php?page=tickets&view=trash");
        exit;
    }

    if ($action === 'permanent_delete' && $staff_role === 'Super Admin') {
        $pdo->prepare("DELETE FROM tickets WHERE id=?")->execute([$ticket_id]);
        logActivity($pdo, $staff_name, 'Permanent Delete', $ticket_id);
        $_SESSION['msg'] = ['Ticket permanently deleted!', 'success'];
        header("Location: admin.php?page=tickets&view=trash");
        exit;
    }

    if ($action === 'update_status') {
        $new_status = sanitizeInput($_POST['new_status'] ?? '');
        if ($ticket_id > 0 && in_array($new_status, ['New','Enquiry','Follow-up','Responded','Closed'])) {
            if (updateTicketStatus($ticket_id, $new_status, $staff_name)) {
                logActivity($pdo, $staff_name, 'Update Status', $ticket_id, "To: $new_status");
                $_SESSION['msg'] = ['Status updated!', 'success'];
                header("Location: admin.php?page=tickets&view_ticket=".$ticket_id);
                exit;
            }
        }
    }

    if ($action === 'add_message') {
        $message = sanitizeInput($_POST['message'] ?? '');
        if ($ticket_id > 0 && !empty($message)) {
            if (addMessage($ticket_id, 'Staff', $message, $staff_name)) {
                $stmt = $pdo->prepare("SELECT ticket_code, customer_name, phone FROM tickets WHERE id=?");
                $stmt->execute([$ticket_id]);
                $t = $stmt->fetch();
                if ($t) {
                    $wa_phone = formatPhoneForWhatsApp($t['phone']);
                    $wa_msg = "Hello {$t['customer_name']}!\n\nTicket: {$t['ticket_code']}\n\n$message";
                    $_SESSION['wa_link'] = "https://wa.me/{$wa_phone}?text=".urlencode($wa_msg);
                    logActivity($pdo, $staff_name, 'Add Message', $ticket_id);
                    $_SESSION['msg'] = ['Message added!', 'success'];
                    header("Location: admin.php?page=tickets&view_ticket=".$ticket_id);
                    exit;
                }
            }
        }
    }
}

$msg = $_SESSION['msg'] ?? null;
unset($_SESSION['msg']);
$wa_link = $_SESSION['wa_link'] ?? '';
unset($_SESSION['wa_link']);

$view = $_GET['view'] ?? 'active';
$page = $_GET['page'] ?? 'tickets';
$status = $_GET['status'] ?? '';
$search = $_GET['search'] ?? '';
$service = $_GET['service'] ?? '';

// Build tickets query
$sql = "SELECT t.*, (SELECT COUNT(*) FROM messages WHERE ticket_id=t.id) as msg_count, (SELECT MAX(created_at) FROM messages WHERE ticket_id=t.id) as last_msg FROM tickets t WHERE is_deleted=?";
$params = [$view==='trash'?1:0];
if($status){ $sql.=" AND t.status=?"; $params[]=$status; }
if($search){ $sql.=" AND (t.ticket_code LIKE ? OR t.customer_name LIKE ? OR t.phone LIKE ?)"; $s="%$search%"; $params[]=$s; $params[]=$s; $params[]=$s; }
if($service){ $sql.=" AND t.service=?"; $params[]=$service; }
$sql.=" ORDER BY t.updated_at DESC LIMIT 100";
$stmt = $pdo->prepare($sql);
$stmt->execute($params);
$tickets = $stmt->fetchAll();

// Stats
$stats = $pdo->query("SELECT COUNT(*) total, SUM(status='New') new_c, SUM(status='Enquiry') enq_c, SUM(status='Follow-up') fol_c, SUM(status='Responded') res_c, SUM(status='Closed') clo_c FROM tickets WHERE is_deleted=0")->fetch();
$trash_count = $pdo->query("SELECT COUNT(*) c FROM tickets WHERE is_deleted=1")->fetch()['c'];

// Ticket modal
$sel_ticket = null;
$msgs = [];
if(isset($_GET['view_ticket'])){
    $tid = intval($_GET['view_ticket']);
    $stmt = $pdo->prepare("SELECT * FROM tickets WHERE id=?");
    $stmt->execute([$tid]);
    $sel_ticket = $stmt->fetch();
    if($sel_ticket){
        $stmt = $pdo->prepare("SELECT * FROM messages WHERE ticket_id=? ORDER BY created_at");
        $stmt->execute([$tid]);
        $msgs = $stmt->fetchAll();
    }
}

// Analytics
$perf = [];
if($page==='analytics'){
    try{
        $perf = $pdo->query("SELECT staff_name, SUM(tickets_created) tc, SUM(tickets_responded) tr, SUM(tickets_closed) tcl, SUM(messages_sent) ms, AVG(avg_response_time) art FROM staff_performance WHERE date>=DATE_SUB(CURDATE(),INTERVAL 30 DAY) GROUP BY staff_name ORDER BY tc DESC")->fetchAll();
    }catch(Exception $e){ $perf=[]; }
}

// Audit
$logs = [];
if($page==='audit' && in_array($staff_role,['Admin','Super Admin'])){
    try{ $logs = $pdo->query("SELECT * FROM activity_logs ORDER BY created_at DESC LIMIT 100")->fetchAll(); }catch(Exception $e){ $logs=[]; }
}

// Users
$users = [];
if($page==='users' && $staff_role==='Super Admin'){
    $users = $pdo->query("SELECT * FROM admin_users ORDER BY created_at DESC")->fetchAll();
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
