<form method="POST" style="display:inline"><input type="hidden" name="ticket_id" value="<?=$t['id']?>"><input type="hidden" name="action" value="restore"><button type="submit" class="btn btn-success btn-xs" title="Restore"><i class="fas fa-undo"></i></button></form>
<?php endif; ?>
<?php if($staff_role==='Super Admin'): ?>
<form method="POST" style="display:inline" onsubmit="return confirm('Permanently delete?')"><input type="hidden" name="ticket_id" value="<?=$t['id']?>"><input type="hidden" name="action" value="permanent_delete"><button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-times"></i></button></form>
<?php endif; ?>
<?php else: ?>
