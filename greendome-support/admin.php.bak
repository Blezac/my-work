.top-left{display:flex;align-items:center;gap:20px}.top-title{font-size:18px;font-weight:700}.top-user{font-size:14px;opacity:.9}
.top-right{display:flex;gap:10px}.top-btn{color:#fff;text-decoration:none;padding:10px 20px;background:rgba(255,255,255,.2);border-radius:6px;font-size:14px;font-weight:600;border:none;cursor:pointer;transition:.3s}
.top-btn:hover{background:rgba(255,255,255,.3)}.btn-logout{background:rgba(220,53,69,.9)}.btn-logout:hover{background:#dc3545}.btn-trash{background:rgba(255,193,7,.9)}.btn-trash:hover{background:#ffc107}
.nav-tabs{background:#fff;border-bottom:2px solid #e9ecef;display:flex}.nav-tab{padding:15px 25px;text-decoration:none;color:#6c757d;border-bottom:3px solid transparent;font-weight:600;transition:.3s}
.nav-tab:hover{background:#f8f9fa;color:#2c5f2d}.nav-tab.active{color:#2c5f2d;border-bottom-color:#2c5f2d;background:#f8f9fa}
.container{max-width:1400px;margin:0 auto;padding:30px 20px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;margin-bottom:30px}
.stat{background:#fff;padding:25px 20px;border-radius:12px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.08);border-left:4px solid #2c5f2d;transition:.2s}
.stat:hover{transform:translateY(-3px);box-shadow:0 4px 12px rgba(0,0,0,.15)}.stat-num{font-size:36px;font-weight:700;color:#2c5f2d;margin-bottom:8px}.stat-lbl{font-size:13px;color:#6c757d;text-transform:uppercase;letter-spacing:.5px;font-weight:600}
