<form method="POST" style="display:inline;margin-left:5px" onsubmit="return confirm('Move to trash?')"><input type="hidden" name="ticket_id" value="<?=$t['id']?>"><input type="hidden" name="action" value="soft_delete"><button type="submit" class="btn btn-warning btn-xs"><i class="fas fa-trash"></i></button></form>
<?php endif; ?>
<?php endif; ?>
</td>
</tr>
<?php endforeach; ?>
</tbody>
</table>
<?php endif; ?>
</div>

<?php elseif($page==='analytics'): ?>
<div class="card">
<h2 style="color:#2c5f2d;margin-bottom:20px"><i class="fas fa-chart-line"></i> Staff Performance (Last 30 Days)</h2>
<?php if(empty($perf)): ?>
<div class="empty"><p>No performance data yet.</p></div>
<?php else: ?>
<table>
<thead><tr><th>Staff</th><th>Created</th><th>Responded</th><th>Closed</th><th>Messages</th><th>Avg Time</th></tr></thead>
<tbody>
<?php foreach($perf as $p): ?>
<tr><td><strong><?=htmlspecialchars($p['staff_name'])?></strong></td><td><?=$p['tc']?></td><td><?=$p['tr']?></td><td><?=$p['tcl']?></td><td><?=$p['ms']?></td><td><?=round($p['art']/60,1)?> min</td></tr>
<?php endforeach; ?>
</tbody>
</table>
<div style="margin-top:30px"><canvas id="chart" height="80"></canvas></div>
<script>
new Chart(document.getElementById('chart'),{
type:'bar',
data:{
labels:<?=json_encode(array_column($perf,'staff_name'))?>,
datasets:[{label:'Created',data:<?=json_encode(array_column($perf,'tc'))?>,backgroundColor:'rgba(44,95,45,0.8)'},{label:'Closed',data:<?=json_encode(array_column($perf,'tcl'))?>,backgroundColor:'rgba(40,167,69,0.8)'}]
},
options:{responsive:true,scales:{y:{beginAtZero:true}}}
});
</script>
<?php endif; ?>
</div>

<?php elseif($page==='audit' && in_array($staff_role,['Admin','Super Admin'])): ?>
<div class="card">
<h2 style="color:#2c5f2d;margin-bottom:20px"><i class="fas fa-history"></i> Activity Log (Last 100)</h2>
<?php if(empty($logs)): ?>
<div class="empty"><p>No logs yet.</p></div>
<?php else: ?>
<table>
<thead><tr><th>Time</th><th>Staff</th><th>Action</th><th>Ticket</th><th>Details</th><th>IP</th></tr></thead>
<tbody>
<?php foreach($logs as $l): ?>
<tr><td><small><?=date('M d, H:i',strtotime($l['created_at']))?></small></td><td><?=htmlspecialchars($l['staff_name'])?></td><td><strong><?=htmlspecialchars($l['action_type'])?></strong></td><td><?=$l['ticket_id']?'<a href="?page=tickets&view_ticket='.$l['ticket_id'].'" style="color:#2c5f2d">#'.$l['ticket_id'].'</a>':'-'?></td><td><small><?=htmlspecialchars($l['details']??'-')?></small></td><td><small><?=htmlspecialchars($l['ip_address'])?></small></td></tr>
<?php endforeach; ?>
</tbody>
</table>
<?php endif; ?>
</div>

<?php elseif($page==='users' && $staff_role==='Super Admin'): ?>
<div class="card">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
<h2 style="color:#2c5f2d"><i class="fas fa-users"></i> User Management</h2>
<a href="user_add.php" class="btn btn-primary"><i class="fas fa-plus"></i> Add User</a>
</div>
<table>
<thead><tr><th>Username</th><th>Name</th><th>Role</th><th>Status</th><th>Created</th><th>Last Login</th><th>Actions</th></tr></thead>
<tbody>
<?php foreach($users as $u): ?>
<tr><td><strong><?=htmlspecialchars($u['username'])?></strong></td><td><?=htmlspecialchars($u['full_name'])?></td><td><span class="badge" style="background:#6c757d;color:#fff"><?=htmlspecialchars($u['role'])?></span></td><td><?=$u['is_active']?'<span class="badge badge-responded">Active</span>':'<span class="badge badge-closed">Inactive</span>'?></td><td><small><?=date('M d, Y',strtotime($u['created_at']))?></small></td><td><small><?=$u['last_login']?date('M d, H:i',strtotime($u['last_login'])):'Never'?></small></td><td><a href="user_edit.php?id=<?=$u['id']?>" class="btn btn-primary btn-xs"><i class="fas fa-edit"></i></a></td></tr>
<?php endforeach; ?>
</tbody>
</table>
</div>
<?php endif; ?>
</div>

<?php if($sel_ticket): ?>
<div class="modal active">
<div class="modal-content">
<div class="modal-header">
<h2><i class="fas fa-ticket-alt"></i> <?=htmlspecialchars($sel_ticket['ticket_code'])?></h2>
<button class="close" onclick="location.href='admin.php?page=tickets'"><i class="fas fa-times"></i></button>
</div>
<div class="modal-body">
<div class="ticket-info">
<div class="info-row"><span class="info-label">Customer:</span><span class="info-value"><?=htmlspecialchars($sel_ticket['customer_name'])?></span></div>
<div class="info-row"><span class="info-label">Phone:</span><span class="info-value"><?=htmlspecialchars($sel_ticket['phone'])?> <a href="https://wa.me/<?=formatPhoneForWhatsApp($sel_ticket['phone'])?>" target="_blank" class="btn btn-success btn-sm" style="margin-left:10px"><i class="fab fa-whatsapp"></i> WhatsApp</a></span></div>
<?php if($sel_ticket['email']): ?><div class="info-row"><span class="info-label">Email:</span><span class="info-value"><?=htmlspecialchars($sel_ticket['email'])?></span></div><?php endif; ?>
<div class="info-row"><span class="info-label">Service:</span><span class="info-value"><?=htmlspecialchars($sel_ticket['service'])?></span></div>
<div class="info-row"><span class="info-label">Initiated:</span><span class="info-value"><?=htmlspecialchars($sel_ticket['initiated_by'])?></span></div>
<div class="info-row"><span class="info-label">Status:</span><span class="info-value"><span class="badge badge-<?=strtolower(str_replace('-','',$sel_ticket['status']))?>"><?=htmlspecialchars($sel_ticket['status'])?></span></span></div>
<div class="info-row"><span class="info-label">Created:</span><span class="info-value"><?=date('M d, Y H:i',strtotime($sel_ticket['created_at']))?></span></div>
</div>

<div class="form-sec">
<form method="POST">
<input type="hidden" name="action" value="update_status">
<input type="hidden" name="ticket_id" value="<?=$sel_ticket['id']?>">
<label>Update Status:</label>
<div style="display:flex;gap:10px">
<select name="new_status" required style="flex:1">
<option value="New" <?=$sel_ticket['status']==='New'?'selected':''?>>New</option>
<option value="Enquiry" <?=$sel_ticket['status']==='Enquiry'?'selected':''?>>Enquiry</option>
<option value="Follow-up" <?=$sel_ticket['status']==='Follow-up'?'selected':''?>>Follow-up</option>
<option value="Responded" <?=$sel_ticket['status']==='Responded'?'selected':''?>>Responded</option>
<option value="Closed" <?=$sel_ticket['status']==='Closed'?'selected':''?>>Closed</option>
</select>
<button type="submit" class="btn btn-success"><i class="fas fa-check"></i> Update</button>
</div>
</form>
</div>

<div class="sec-title"><i class="fas fa-comments"></i> Conversation</div>
<div class="convo">
<?php foreach($msgs as $m): ?>
<div class="msg msg-<?=strtolower($m['sender'])?>">
<div class="msg-sender"><?=$m['sender']==='Customer'?'<i class="fas fa-user"></i> Customer':'<i class="fas fa-user-tie"></i> Staff'?><?=$m['staff_name']?' ('.htmlspecialchars($m['staff_name']).')':''?></div>
<div class="msg-text"><?=nl2br(htmlspecialchars($m['message']))?></div>
<div class="msg-time"><?=date('M d, Y H:i',strtotime($m['created_at']))?></div>
</div>
<?php endforeach; ?>
</div>

<div class="form-sec">
<form method="POST">
<input type="hidden" name="action" value="add_message">
<input type="hidden" name="ticket_id" value="<?=$sel_ticket['id']?>">
<label>Add Message:</label>
<textarea name="message" placeholder="Type your message..." required></textarea>
<small style="display:block;color:#6c757d;margin-bottom:12px"><i class="fas fa-info-circle"></i> Message will be logged and you'll get WhatsApp link</small>
<button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Add Message</button>
</form>
</div>
</div>
</div>
</div>
<?php endif; ?>

<script>
document.addEventListener('click',e=>{if(e.target.classList.contains('modal'))location.href='admin.php?page=tickets'});
const c=document.querySelector('.convo');
if(c)c.scrollTop=c.scrollHeight;
</script>
</body>
</html>
