<?php

require_once 'includes/config.php';

$error = '';
$success = '';

// Handle form submission
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    // Sanitize inputs
    $service = sanitizeInput($_POST['service'] ?? '');
    $customer_name = sanitizeInput($_POST['customer_name'] ?? '');
    $phone = sanitizeInput($_POST['phone'] ?? '');
    $email = sanitizeInput($_POST['email'] ?? '');
    $message = sanitizeInput($_POST['message'] ?? '');
    
    // Validation
    if (empty($service) || empty($customer_name) || empty($phone) || empty($message)) {
        $error = 'Please fill in all required fields.';
    } elseif (!in_array($service, ['Education', 'IT Services', 'CLACS-Farm', 'Automobile'])) {
        $error = 'Invalid service selected.';
    } elseif (!validatePhone($phone)) {
        $error = 'Please enter a valid phone number.';
    } elseif (!empty($email) && !filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $error = 'Please enter a valid email address.';
    } else {
        // Create ticket
        $result = createTicket($service, $customer_name, $phone, $email, 'Customer', $message);
        
        if ($result['success']) {
            $ticket_code = $result['ticket_code'];
            
            // Format phone for WhatsApp
            $wa_phone = formatPhoneForWhatsApp($phone);
            
            // Create WhatsApp message
            $wa_message = "Hello! I'm contacting you regarding my support request.\n\n";
            $wa_message .= " Ticket ID: " . $ticket_code . "\n";
            $wa_message .= " Name: " . $customer_name . "\n";
            $wa_message .= " Service: " . $service . "\n\n";
            $wa_message .= " Message:\n" . $message;
            
            // URL encode the message
            $wa_message_encoded = urlencode($wa_message);
            
            // Redirect to WhatsApp
            $whatsapp_url = "https://wa.me/" . COMPANY_WHATSAPP . "?text=" . $wa_message_encoded;
            
            header("Location: " . $whatsapp_url);
            exit;
        } else {
            $error = $result['error'] ?? 'Failed to create ticket. Please try again.';
        }
    }
}
?>
