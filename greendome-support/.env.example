# Greendome Engineering Support System
# Environment Configuration Template
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=localhost
DB_NAME=greendome_support
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# WhatsApp Configuration
COMPANY_WHATSAPP=2349024900124

# System Settings
TICKET_PREFIX=GETS-
TIMEZONE=Africa/Lagos

# Security
SESSION_TIMEOUT=3600
WEBHOOK_VERIFY_TOKEN=greendome_webhook_token_2024

# Environment
APP_ENV=production
DEBUG_MODE=false
ERROR_REPORTING=false

# Optional: Email Configuration (for future enhancements)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@greendome.com
SMTP_FROM_NAME=Greendome Support

# Optional: SMS Configuration (for future enhancements)
SMS_API_KEY=
SMS_SENDER_ID=GREENDOME

# Notes:
# - Never commit .env file to version control
# - Keep sensitive credentials secure
# - Use strong passwords
# - Restrict file permissions (chmod 600 .env)
